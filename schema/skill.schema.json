{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OtterClaw SKILL.md Frontmatter",
  "description": "Schema for YAML frontmatter in OtterClaw skill files. Includes capability manifest for SecClaw-gated runtime enforcement.",
  "type": "object",
  "required": ["name", "description", "version", "author", "tags", "requires"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Globally unique skill identifier. Used by the runtime and SecClaw event stream."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Lowercase, hyphenated skill identifier."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "One-sentence description of what the skill does."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (major.minor.patch)."
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "description": "Publisher identity (e.g. @orderly-network). Used for bundle-level attestation."
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 content hash of the skill file. Verified at install and deploy time."
    },
    "previousVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Version this release supersedes. Enables capability-diff between versions."
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "description": "Author name or handle."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "minItems": 1,
      "description": "Lowercase tags for discoverability."
    },
    "requires": {
      "type": "object",
      "required": ["bins", "install"],
      "additionalProperties": false,
      "properties": {
        "bins": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "CLI binaries the skill depends on."
        },
        "install": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "command", "bins", "label"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier for the install step."
              },
              "kind": {
                "type": "string",
                "enum": ["command"],
                "description": "Type of install step."
              },
              "command": {
                "type": "string",
                "description": "Shell command to run."
              },
              "bins": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Binaries this step provides."
              },
              "label": {
                "type": "string",
                "description": "Human-readable label for the step."
              }
            }
          },
          "minItems": 1,
          "description": "Steps to install required binaries."
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "description": "Structured capability manifest. Declares all CLI, network, filesystem, and env access the skill requires. Undeclared access is blocked at runtime and reported to SecClaw.",
      "properties": {
        "cli": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["binary", "subcommands"],
            "additionalProperties": false,
            "properties": {
              "binary": {
                "type": "string",
                "description": "CLI binary name (e.g. npm, gh, orderly)."
              },
              "subcommands": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1,
                "description": "Allowed subcommands for this binary."
              },
              "allowedPackages": {
                "type": "array",
                "items": { "type": "string" },
                "description": "For package managers: allowed package specifiers (e.g. next@^14.0.0)."
              },
              "allowedRoutes": {
                "type": "array",
                "items": { "type": "string" },
                "description": "For API CLIs (e.g. gh): allowed API route patterns."
              }
            }
          },
          "description": "Declared CLI binary invocations. Every runtime.exec() call must match an entry here."
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "egress": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Allowed outbound hostnames for runtime.fetch()."
            }
          },
          "description": "Network access declarations."
        },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Glob patterns for allowed read paths."
            },
            "write": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Glob patterns for allowed write paths."
            },
            "denied": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Glob patterns for unconditionally denied paths (e.g. ~/.ssh/**, **/.env*)."
            }
          },
          "description": "Filesystem access declarations."
        },
        "env": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reads": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Environment variable names the skill may read."
            },
            "denied": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Environment variable patterns that are unconditionally denied (e.g. AWS_*)."
            }
          },
          "description": "Environment variable access declarations."
        }
      }
    },
    "payment": {
      "type": "object",
      "required": ["scheme", "price", "currency", "per", "recipient"],
      "additionalProperties": false,
      "properties": {
        "scheme": {
          "type": "string",
          "enum": ["orderly-ledger"],
          "description": "Payment scheme identifier."
        },
        "price": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$",
          "description": "Price per unit as a decimal string."
        },
        "currency": {
          "type": "string",
          "enum": ["USDC"],
          "description": "Payment currency."
        },
        "per": {
          "type": "string",
          "enum": ["request"],
          "description": "Billing unit."
        },
        "recipient": {
          "type": "string",
          "minLength": 1,
          "description": "Orderly account ID of the skill provider."
        }
      },
      "description": "402 payment configuration for premium skills. Optional."
    }
  }
}
